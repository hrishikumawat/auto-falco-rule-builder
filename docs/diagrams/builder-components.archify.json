    "cards":  [
                  {
                      "dot":  "cyan",
                      "title":  "Engineer supplies",
                      "items":  [
                                    "Falco alert file, explicit process / namespace intent, and a profile matching their own Falco deployment.",
                                    "Real replay needs compatible scap captures and positive / negative assertions. JSON alerts alone are not runtime tests."
                                ]
                  },
                  {
                      "dot":  "emerald",
                      "title":  "Use the exported rule file",
                      "items":  [
                                    "Recommended: review candidate.yaml and add it as a separate Helm customRules file.",
                                    "Alternatively replace your owned custom file, or merge entries into it and retest. The builder currently exports files; it does not edit Helm values or deployed rules."
                                ]
                  },
                  {
                      "dot":  "amber",
                      "title":  "Two files can be loaded together",
                      "items":  [
                                    "Helm customRules mounts named files under /etc/falco/rules.d; include that directory in falco.rules_files.",
                                    "Multiple files are loaded in order, not concatenated on disk. Check rule/macro names, override semantics, dependencies and overlap before applying.",
                                    "Exported failure / incomplete reports are not approval to install. Helm handoff is described in the companion onboarding note."
                                ]
                  }
              ]
