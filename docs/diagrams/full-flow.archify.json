    "cards":  [
                  {
                      "dot":  "cyan",
                      "title":  "How logs become a rule",
                      "items":  [
                                    "The CLI reads JSON/JSONL alerts, groups evidence, preserves provenance and missing fields, and redacts exports.",
                                    "Explicit process / namespace intent and supported profile fields drive deterministic templates. No LLM in v1; matched alerts are not a behavior baseline."
                                ]
                  },
                  {
                      "dot":  "emerald",
                      "title":  "What is proven",
                      "items":  [
                                    "Falco 0.45.0 lab replay passed process positive/negative, tuning suppress/preserve, and ordered dependencies.",
                                    "Combined replay detected an earlier overlapping rule. Hermes independently passed the 41-test unit suite."
                                ]
                  },
                  {
                      "dot":  "amber",
                      "title":  "What remains",
                      "items":  [
                                    "The host capture has no Kubernetes metadata: prod/dev nsenter detection remains unproven.",
                                    "Provide metadata-bearing captures and the organization\u0027s real deployment profile. Keep the builder central between SOC evidence and human-reviewed detection changes."
                                ]
                  }
              ]
